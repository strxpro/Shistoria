# Supabase (already configured in src/lib/supabase.ts)
NEXT_PUBLIC_SUPABASE_URL=https://slatelpipxtqveydgslc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Modele 3D z Supabase Storage (CDN) — szybsze ładowanie.
# Zostaw puste, by używać plików lokalnych z /public.
# Bucket publiczny "model": https://<projekt>.supabase.co/storage/v1/object/public/model
NEXT_PUBLIC_MODELS_URL=https://slatelpipxtqveydgslc.supabase.co/storage/v1/object/public/model

# Facebook Page API (for event publishing)
NEXT_PUBLIC_FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Instagram Business Account (uses same FB token)
IG_BUSINESS_ACCOUNT_ID=

# Google Translate API (for auto-translation of events)
GOOGLE_TRANSLATE_API_KEY=

# GIPHY — wyszukiwarka GIF/memów w komentarzach community (typ klucza: API, platforma: Web)
# Utwórz na https://developers.giphy.com (Create an API Key → API → Web). Dziala na wszystkich urzadzeniach.
NEXT_PUBLIC_GIPHY_KEY=

# Google Places API — automatyczny import recenzji z wizytówki Google
# 1) Google Cloud Console → włącz "Places API"
# 2) Utwórz klucz API → wklej poniżej jako GOOGLE_PLACES_API_KEY
# 3) Znajdź Place ID lokalu: https://developers.google.com/maps/documentation/places/web-service/place-id
# Endpoint importu (cron raz dziennie): /api/import-google-reviews?secret=ANNOUNCE_SECRET
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Sekret chroniący endpointy cron (announce-winner, import-google-reviews)
ANNOUNCE_SECRET=

# ── Google Business Profile API (DARMOWE, WSZYSTKIE recenzje) ──────────────
# Pełna instrukcja: GOOGLE_REVIEWS_IMPORT.md
# Refresh token z OAuth Playground (scope: business.manage), konto zarządzające wizytówką.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Mapa w stopce e-maili (obrazek). Opcjonalne — bez klucza pokazuje się ładna markowa karta lokalizacji.
# Jeśli ustawisz, włącz w Google Cloud "Maps Static API". Może to być ten sam klucz co GOOGLE_PLACES_API_KEY.
GOOGLE_STATIC_MAPS_KEY=

# Sekcja "Social" — prawdziwa tablica Facebooka (oficjalny Page Plugin, bez tokenu).
# Domyślnie: https://www.facebook.com/SHistoriaSardegna
# Ustaw, jeśli adres Twojej Strony FB jest inny (musi być publiczny adres Strony, nie profilu).
NEXT_PUBLIC_FB_PAGE_URL=https://www.facebook.com/SHistoriaSardegna

# Instagram Graph API — prawdziwa galeria (zdjecia + wideo + REELS, bez limitu 6).
# Endpoint: /api/instagram. Klucz trzymany TYLKO po stronie serwera (nie NEXT_PUBLIC).
# Jak zdobyc: patrz INSTAGRAM_API_SETUP.md
META_ACCESS_TOKEN=
IG_USER_ID=
# Facebook — prawdziwe posty Strony przez Graph API (ten sam token). FB_PAGE_ID z me/accounts.
FB_PAGE_ID=

# Publikacja eventów na IG/FB/Story (webhook make – "as data arrived").
# Wklej URL z modułu "Webhooks → Custom webhook" w scenariuszu "Publikacja eventów".
NEXT_PUBLIC_MAKE_EVENT_PUBLISH_WEBHOOK=
